@model List<ITDestek.Models.Entities.Ticket>
@{
    ViewData["Title"] = "Taleplerim";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-800 mb-2">Taleplerim</h1>
            <p class="text-gray-600">Oluşturduğunuz tüm talepleri görüntüleyin ve takip edin.</p>
        </div>
        <a href="/Tickets/Create" class="bg-primary hover:bg-secondary text-white font-semibold py-3 px-6 rounded-lg transition duration-200 transform hover:scale-[1.02] shadow-lg">
            <i class="fas fa-plus-circle mr-2"></i>Yeni Talep
        </a>
    </div>
    
    <!-- Filters and Search -->
    <div class="bg-white rounded-xl shadow-md p-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Durum</label>
                <select id="statusFilter" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                    <option value="">Tümü</option>
                    <option value="New">Yeni</option>
                    <option value="Assigned">Atandı</option>
                    <option value="InProgress">İşlemde</option>
                    <option value="Resolved">Çözüldü</option>
                    <option value="Closed">Kapalı</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Öncelik</label>
                <select id="priorityFilter" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                    <option value="">Tümü</option>
                    <option value="Low">Düşük</option>
                    <option value="Medium">Orta</option>
                    <option value="High">Yüksek</option>
                    <option value="Urgent">Acil</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Ara</label>
                <input type="text" id="searchInput" placeholder="Talep no veya başlık..." 
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" />
            </div>
            <div class="flex items-end">
                <button onclick="filterTickets()" class="w-full bg-primary hover:bg-secondary text-white font-semibold py-2 px-4 rounded-lg transition duration-200">
                    <i class="fas fa-filter mr-2"></i>Filtrele
                </button>
            </div>
        </div>
    </div>
    
    <!-- Tickets Table -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200" id="ticketsTable">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Talep No</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Başlık</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Kategori</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Departman</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Öncelik</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Durum</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Atanan Kişi</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tarih</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @if (Model.Any())
                    {
                        @foreach (var ticket in Model)
                        {
                            <tr class="hover:bg-gray-50 ticket-row" 
                                data-status="@ticket.Status" 
                                data-priority="@ticket.Priority">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm font-semibold text-gray-900">@ticket.TicketNumber</span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-sm text-gray-900">@ticket.Title</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm text-gray-600">@ticket.Category.Name</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm text-gray-600">@ticket.Department.Name</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @{
                                        var priorityClass = ticket.Priority switch
                                        {
                                            ITDestek.Models.Entities.Priority.Düsük => "bg-gray-100 text-gray-800",
                                            ITDestek.Models.Entities.Priority.Orta => "bg-blue-100 text-blue-800",
                                            ITDestek.Models.Entities.Priority.Yüksek => "bg-orange-100 text-orange-800",
                                            ITDestek.Models.Entities.Priority.Kritik => "bg-red-100 text-red-800",
                                            _ => "bg-gray-100 text-gray-800"
                                        };
                                        
                                        var priorityText = ticket.Priority switch
                                        {
                                            ITDestek.Models.Entities.Priority.Düsük => "Düşük",
                                            ITDestek.Models.Entities.Priority.Orta => "Orta",
                                            ITDestek.Models.Entities.Priority.Yüksek => "Yüksek",
                                            ITDestek.Models.Entities.Priority.Kritik => "Kritik",
                                            _ => "Bilinmiyor"
                                        };
                                    }
                                    <span class="px-2 py-1 text-xs font-medium rounded-full @priorityClass">@priorityText</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @{
                                        var statusClass = ticket.Status switch
                                        {
                                            ITDestek.Models.Entities.Status.Yeni => "bg-blue-100 text-blue-800",
                                            ITDestek.Models.Entities.Status.Atandi => "bg-purple-100 text-purple-800",
                                            ITDestek.Models.Entities.Status.Islemde => "bg-orange-100 text-orange-800",
                                            ITDestek.Models.Entities.Status.Cozüldü => "bg-green-100 text-green-800",
                                            ITDestek.Models.Entities.Status.Kapali => "bg-gray-100 text-gray-800",
                                            _ => "bg-gray-100 text-gray-800"
                                        };
                                        
                                        var statusText = ticket.Status switch
                                        {
                                            ITDestek.Models.Entities.Status.Yeni => "Yeni",
                                            ITDestek.Models.Entities.Status.Atandi => "Atandı",
                                            ITDestek.Models.Entities.Status.Islemde => "İşlemde",
                                            ITDestek.Models.Entities.Status.Cozüldü => "Çözüldü",
                                            ITDestek.Models.Entities.Status.Kapali => "Kapalı",
                                            _ => "Bilinmiyor"
                                        };
                                    }
                                    <span class="px-2 py-1 text-xs font-medium rounded-full @statusClass">@statusText</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (ticket.AssignedTo != null)
                                    {
                                        <span class="text-sm text-gray-900">@ticket.AssignedTo.Email</span>
                                    }
                                    else
                                    {
                                        <span class="text-sm text-gray-400">-</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm text-gray-500">@ticket.CreatedDate.ToString("dd.MM.yyyy")</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <a href="/Tickets/Details/@ticket.Id" class="text-primary hover:text-secondary font-medium mr-3">
                                        <i class="fas fa-eye mr-1"></i>Detay
                                    </a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("ITStaff"))
                                    {
                                        <form asp-action="Delete" asp-route-id="@ticket.Id" method="post" class="inline" onsubmit="return confirm('Bu talebi silmek istediğinizden emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="text-red-600 hover:text-red-800 font-medium">
                                                <i class="fas fa-trash mr-1"></i>Sil
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="px-6 py-8 text-center text-gray-500">
                                <i class="fas fa-inbox text-4xl text-gray-300 mb-3"></i>
                                <p>Henüz talep bulunmamaktadır.</p>
                                <a href="/Tickets/Create" class="inline-block mt-4 text-primary hover:text-secondary font-medium">
                                    İlk talebinizi oluşturun →
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterTickets() {
            const statusFilter = document.getElementById('statusFilter').value.toLowerCase();
            const priorityFilter = document.getElementById('priorityFilter').value.toLowerCase();
            const searchText = document.getElementById('searchInput').value.toLowerCase();
            
            const rows = document.querySelectorAll('.ticket-row');
            
            rows.forEach(row => {
                const status = row.dataset.status.toLowerCase();
                const priority = row.dataset.priority.toLowerCase();
                const title = row.querySelector('td:nth-child(2)').textContent.toLowerCase();
                const ticketNo = row.querySelector('td:nth-child(1)').textContent.toLowerCase();
                
                let show = true;
                
                // Filter by status
                if (statusFilter && status !== statusFilter) {
                    show = false;
                }
                
                // Filter by priority
                if (priorityFilter && priority !== priorityFilter) {
                    show = false;
                }
                
                // Search in title and ticket number
                if (searchText && !title.includes(searchText) && !ticketNo.includes(searchText)) {
                    show = false;
                }
                
                row.style.display = show ? '' : 'none';
            });
        }
        
        // Real-time search
        document.getElementById('searchInput').addEventListener('input', filterTickets);
    </script>
}
