@model ITDestek.Controllers.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap - Tuzla Belediyesi IT Destek</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#005BAA',
                        secondary: '#1E88E5',
                        background: '#F5F7FA',
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-background font-sans">
    <div class="min-h-screen flex">
        <!-- Left Side - Illustration -->
        <div class="hidden lg:flex lg:w-1/2 bg-primary items-center justify-center relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-primary to-secondary opacity-90"></div>
            <div class="relative z-10 text-white p-12 text-center">
                <div class="mb-8">
                    <img src="/images/tuzla-belediyesi-yeni-logo.jpg" alt="Tuzla Belediyesi" class="w-40 h-40 mx-auto mb-6 drop-shadow-lg bg-white bg-opacity-20 rounded-2xl p-4" />
                </div>
                <h2 class="text-4xl font-bold mb-6">Tuzla Belediyesi</h2>
                <h3 class="text-2xl font-semibold mb-4">IT Destek Sistemi</h3>
                <p class="text-lg opacity-90 mb-8">Bilgi İşlem Müdürlüğü Destek Portalı</p>
                <div class="space-y-4">
                    <div class="flex items-center space-x-3">
                        <i class="fas fa-check-circle text-2xl"></i>
                        <span class="text-lg">Hızlı ve etkin destek</span>
                    </div>
                    <div class="flex items-center space-x-3">
                        <i class="fas fa-check-circle text-2xl"></i>
                        <span class="text-lg">7/24 talep takibi</span>
                    </div>
                    <div class="flex items-center space-x-3">
                        <i class="fas fa-check-circle text-2xl"></i>
                        <span class="text-lg">Merkezi yardım masası</span>
                    </div>
                </div>
            </div>
            <!-- Decorative circles -->
            <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-white opacity-5 rounded-full"></div>
            <div class="absolute -top-32 -left-32 w-96 h-96 bg-white opacity-5 rounded-full"></div>
        </div>
        
        <!-- Right Side - Login Form -->
        <div class="w-full lg:w-1/2 flex items-center justify-center p-8">
            <div class="w-full max-w-md">
                <!-- Logo and Title (Mobile) -->
                <div class="lg:hidden text-center mb-8">
                    <div class="inline-flex items-center justify-center w-16 h-16 bg-primary rounded-xl mb-4">
                        <i class="fas fa-headset text-3xl text-white"></i>
                    </div>
                    <h1 class="text-2xl font-bold text-gray-800 mb-2">Tuzla Belediyesi</h1>
                    <p class="text-gray-600">IT Destek Sistemi</p>
                </div>
                
                <!-- Login Card -->
                <div class="bg-white rounded-2xl shadow-xl p-8">
                    <div class="text-center mb-4">
                        <img src="/images/tuzla-belediyesi-yeni-logo.jpg" alt="Tuzla Belediyesi" class="w-24 h-24 mx-auto mb-4 bg-white bg-opacity-10 rounded-full p-2" />
                        <h2 class="text-2xl font-bold text-gray-800 mb-2">Hoş Geldiniz</h2>
                        <p class="text-gray-600">Kurumsal hesabınızla giriş yapın</p>
                    </div>
                    
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty))
                    {
                        <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
                            <div class="flex items-center">
                                <i class="fas fa-exclamation-circle mr-2"></i>
                                <span>@ViewData.ModelState[string.Empty].Errors[0].ErrorMessage</span>
                            </div>
                        </div>
                    }
                    
                    <form asp-action="Login" method="post" class="space-y-6">
                        @Html.AntiForgeryToken()
                        
                        <div>
                            <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-2">
                                <i class="fas fa-envelope mr-2"></i>Kurumsal E-posta
                            </label>
                            <input asp-for="Email" 
                                   type="email" 
                                   class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent transition duration-200"
                                   placeholder="ahmet.yilmaz@tuzla.bel.tr"
                                   autocomplete="email" />
                            <span asp-validation-for="Email" class="text-red-600 text-sm mt-1 block"></span>
                        </div>
                        
                        <div>
                            <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-2">
                                <i class="fas fa-lock mr-2"></i>Şifre
                            </label>
                            <input asp-for="Password" 
                                   type="password" 
                                   class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent transition duration-200"
                                   placeholder="••••••••"
                                   autocomplete="current-password" />
                            <span asp-validation-for="Password" class="text-red-600 text-sm mt-1 block"></span>
                        </div>
                        
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <input asp-for="RememberMe" 
                                       type="checkbox"
                                       class="h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded" />
                                <label asp-for="RememberMe" class="ml-2 block text-sm text-gray-700">
                                    Beni Hatırla
                                </label>
                            </div>
                            <a href="#" class="text-sm font-medium text-primary hover:text-secondary transition duration-200">
                                Şifremi Unuttum
                            </a>
                        </div>
                        
                        <button type="submit" 
                                class="w-full bg-primary hover:bg-secondary text-white font-semibold py-3 px-4 rounded-lg transition duration-200 transform hover:scale-[1.02] shadow-lg hover:shadow-xl">
                            <i class="fas fa-sign-in-alt mr-2"></i>Giriş Yap
                        </button>
                    </form>
                    
                    <div class="mt-6 pt-6 border-t border-gray-200">
                        <p class="text-xs text-center text-gray-500">
                            <i class="fas fa-info-circle mr-1"></i>
                            Sadece @@tuzla.bel.tr uzantılı kurumsal e-posta adresleri ile giriş yapılabilir.
                        </p>
                    </div>
                </div>
                
                <!-- Footer -->
                <div class="mt-8 text-center">
                    <p class="text-sm text-gray-600">
                        © 2026 Tuzla Belediyesi - Bilgi İşlem Müdürlüğü
                    </p>
                </div>
            </div>
        </div>
    </div>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
