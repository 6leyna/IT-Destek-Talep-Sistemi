@model ITDestek.Controllers.ArticleViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="max-w-4xl mx-auto">
    <!-- Geri Dön Butonu -->
    <a asp-action="Index" class="inline-flex items-center text-primary hover:text-secondary mb-4 transition">
        <i class="fas fa-arrow-left mr-2"></i>
        Bilgi Bankası'na Dön
    </a>
    
    <!-- Makale Başlık -->
    <div class="bg-white rounded-xl shadow-md p-8 mb-6">
        <div class="flex items-start justify-between mb-6">
            <div class="flex items-center space-x-4">
                <div class="w-16 h-16 bg-@Model.Color-100 rounded-lg flex items-center justify-center">
                    <i class="fas @Model.Icon text-@Model.Color-500 text-3xl"></i>
                </div>
                <div>
                    <h1 class="text-3xl font-bold text-gray-800">@Model.Title</h1>
                    <p class="text-sm text-gray-500 mt-1"><i class="fas fa-eye mr-1"></i>@Model.Views görüntüleme</p>
                </div>
            </div>
        </div>
        
        <!-- Makale İçeriği -->
        <div class="prose max-w-none">
            @Html.Raw(Model.Content)
        </div>
    </div>
    
    <!-- Faydalı Oldu mu? -->
    <div class="bg-white rounded-xl shadow-md p-6" id="feedbackSection">
        <div class="flex items-center justify-between" id="feedbackButtons">
            <span class="text-gray-700 font-medium">Bu makale faydalı oldu mu?</span>
            <div class="flex items-center space-x-3">
                <button onclick="sendFeedback('yes')" class="flex items-center px-4 py-2 bg-green-50 text-green-600 rounded-lg hover:bg-green-100 transition">
                    <i class="fas fa-thumbs-up mr-2"></i>Evet
                </button>
                <button onclick="sendFeedback('no')" class="flex items-center px-4 py-2 bg-red-50 text-red-600 rounded-lg hover:bg-red-100 transition">
                    <i class="fas fa-thumbs-down mr-2"></i>Hayır
                </button>
            </div>
        </div>
        <div class="hidden text-center py-2" id="feedbackThanks">
            <i class="fas fa-check-circle text-green-500 text-2xl mb-2"></i>
            <p class="text-gray-700 font-medium">Geri bildiriminiz için teşekkürler!</p>
        </div>
    </div>
    
    <!-- İlgili Makaleler -->
    <div class="mt-8">
        <h2 class="text-xl font-bold text-gray-800 mb-4">İlgili Makaleler</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <a asp-action="Details" asp-route-id="1" class="bg-white rounded-lg shadow-sm p-4 hover:shadow-md transition block no-underline">
                <div class="flex items-center">
                    <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
                        <i class="fas fa-print text-blue-500"></i>
                    </div>
                    <div>
                        <h3 class="font-semibold text-gray-800">Yazıcıya Nasıl Bağlanır?</h3>
                        <p class="text-xs text-gray-500">Ağ yazıcısı ekleme adımları</p>
                    </div>
                </div>
            </a>
            
            <a asp-action="Details" asp-route-id="5" class="bg-white rounded-lg shadow-sm p-4 hover:shadow-md transition block no-underline">
                <div class="flex items-center">
                    <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center mr-3">
                        <i class="fas fa-wifi text-red-500"></i>
                    </div>
                    <div>
                        <h3 class="font-semibold text-gray-800">İnternet Bağlantı Sorunları</h3>
                        <p class="text-xs text-gray-500">WiFi sorun giderme</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

<script>
    function sendFeedback(type) {
        document.getElementById('feedbackButtons').classList.add('hidden');
        document.getElementById('feedbackThanks').classList.remove('hidden');
    }
</script>
